# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

!.env.example

# Snapshots used by scripts/port and scripts/design (re-fetchable, never committed)
/.port-cache/
/.design-cache/

# QA output
/qa-out/
sweep-report.json

# Raw captures of the sites Qwarter built (scripts/work/shoot.mjs): tens of MB of PNG, re-shootable.
# scripts/work/prepare.mjs writes the delivered JPEGs next to them, and those are committed.
/public/media/work/*/raw/
__pycache__/
