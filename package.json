    "qa:sweep": "node scripts/qa/sweep.mjs",
    "qa:sheet": "node scripts/qa/sheet.mjs"
  },
  "dependencies": {
    "@paper-design/shaders-react": "^0.0.80",
    "next": "16.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "fontkit": "^2.0.4",
    "linkedom": "^0.18.14",
    "playwright": "^1.63.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
