        {
          "tag": "p",
          "text": "Home Blog Healthcare in Colombia Healthcare & Community How Nonprofits Create Direct Impact in Colombia Discover how nonprofits in Colombia create direct...",
          "where": "main"
        },
        {
          "tag": "h3",
          "text": "Access To Healthcare In Colombia: The Reality Behind The Numbers",
          "where": "main"
        },
        {
          "tag": "p",
          "text": "Millions of Colombians still face barriers to healthcare despite near-universal coverage. Learn how nonprofits like Kind Footprint help vulnerable communities access life-saving...",
          "where": "main"
        },
        {
          "tag": "h2",
          "text": "Volunteer With Us: Help Save Lives In Medellín",
          "where": "main"
        },
        {
          "tag": "p",
          "text": "Your time and skills can make a real difference in Medellín’s most vulnerable communities. Kind Footprint offers flexible volunteer roles in the field, remotely, and through U.S. university internship programs. Minimum commitment: one month.",
          "where": "main"
        },
