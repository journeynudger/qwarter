        {
          "tag": "h2",
          "text": "VISUAL PRAYERS FOR THE EARTH",
          "where": "main"
        },
        {
          "tag": "h1",
          "text": "Art that invites reflection, responsibility, and hope for the Earth we share",
          "where": "main"
