        "height": 5652
      },
      "text": [
        {
          "tag": "h1",
          "text": "SA-S1",
          "where": "main"
        },
        {
          "tag": "p",
          "text": "61 real analog samples. Pads, leads, bass, plucks, and FX with the full character of the Oberheim OB-Xa. 16-voice polyphony, ADSR envelope, 4 built-in effects.",
          "where": "main"
        },
        {
          "tag": "li",
          "text": "4 built-in effects: Drive, Phaser, Delay, Reverb",
          "where": "main"
        },
        {
          "tag": "li",
          "text": "macOS + Windows · VST3, AU",
          "where": "main"
        },
        {
          "tag": "h2",
          "text": "Play SA-S1 in your browser",
          "where": "main"
        },
        {
          "tag": "p",
          "text": "The real presets. The real signal chain. Press a key to try it.",
          "where": "main"
        },
        {
          "tag": "h3",
          "text": "Preset Browser",
          "where": "main"
        },
        {
          "tag": "p",
          "text": "Flip through every preset from the on-board dropdown — pads, leads, bass, plucks, and FX — and audition sounds in real time while you play.",
          "where": "main"
        },
        {
          "tag": "h3",
          "text": "ADSR Envelope",
          "where": "main"
        },
        {
          "tag": "p",
          "text": "Shape every note with Attack, Decay, Sustain, and Release. Go from sharp, percussive plucks to slow, swelling pads with four knobs.",
          "where": "main"
        },
        {
          "tag": "h3",
          "text": "Built-in Effects",
          "where": "main"
        },
        {
          "tag": "p",
          "text": "Drive, Phaser, Delay, and Reverb are built right in. Add grit, movement, and space without ever leaving the plugin.",
          "where": "main"
        },
        {
          "tag": "h3",
          "text": "VU Meter",
          "where": "main"
        },
        {
          "tag": "p",
          "text": "A classic analog VU meter shows your real-time output level, so every patch sits in the sweet spot — clean and punchy.",
          "where": "main"
        },
        {
          "tag": "h3",
          "text": "Filters & Output",
          "where": "main"
        },
        {
          "tag": "p",
          "text": "Sculpt the tone with Lo Cut and Hi Cut, then set the level with Output Gain for consistent gain staging in any mix.",
          "where": "main"
        },
        {
          "tag": "h2",
          "text": "Specifications",
          "where": "main"
        },
        {
          "tag": "li",
          "text": "Attack · Decay · Sustain · Release",
          "where": "main"
        },
        {
          "tag": "li",
          "text": "Drive · Phaser · Delay · Reverb",
          "where": "main"
        },
        {
          "tag": "li",
          "text": "Lo Cut · Hi Cut · Output Gain",
          "where": "main"
        },
        {
          "tag": "h2",
          "text": "Frequently Asked Questions",
          "where": "main"
        },
        {
          "tag": "h3",
          "text": "Which formats and platforms are supported?",
          "where": "main"
        },
        {
          "tag": "h3",
          "text": "How is it delivered?",
          "where": "main"
        },
        {
          "tag": "h3",
          "text": "Is this a one-time purchase?",
          "where": "main"
        },
        {
          "tag": "h3",
          "text": "Do I need an account?",
          "where": "main"
        },
        {
          "tag": "h3",
          "text": "What's your refund policy?",
          "where": "main"
        },
        {
          "tag": "h3",
          "text": "How do I get updates?",
          "where": "main"
        }
