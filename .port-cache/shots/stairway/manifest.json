    {
      "name": "shop-sa-s1",
      "route": "/shop/sa-s1",
      "url": "https://stairway.audio/shop/sa-s1",
      "title": "SA-S1 · Stairway Audio",
      "description": "61 real analog samples. Pads, leads, bass, plucks, and FX with the full character of the Oberheim OB-Xa. 16-voice polyphony, ADSR envelope, 4 built-in effects.",
      "height": 6344,
      "frame": "shop-sa-s1.png",
      "full": "shop-sa-s1-full.png",
      "videos": [],
      "phone": {
        "frame": "m-shop-sa-s1.png",
