          "where": "main"
        },
        {
          "tag": "h3",
          "text": "Impact Tracking Dashboard",
          "where": "main"
        },
        {
          "tag": "p",
          "text": "This feature transforms traditional performance management by focusing on measurable contributions to mission-critical projects and strategic initiatives.",
          "where": "main"
        },
        {
          "tag": "li",
