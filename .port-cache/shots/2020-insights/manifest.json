          "where": "main"
        },
        {
          "tag": "li",
          "text": "Progress Visualizations: Clear dashboards show goal progress.",
          "where": "main"
        },
        {
          "tag": "li",
          "text": "Executive & HR Insights: Advanced reporting for a bird's-eye view.",
          "where": "main"
        },
        {
          "tag": "h2",
          "text": "WHAT PEOPLE SAY ABOUT INSIGHTS",
          "where": "main"
        },
        {
