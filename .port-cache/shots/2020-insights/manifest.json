    {
      "name": "our-story",
      "route": "/our-story",
      "url": "https://2020insights.net/our-story",
      "title": "Our Story | Insights",
      "description": null,
      "height": 2362,
      "frame": "our-story.png",
      "full": "our-story-full.png",
      "videos": [],
      "phone": {
        "frame": "m-our-story.png",
        "full": "m-our-story-full.png",
        "height": 3764
      },
      "text": [
        {
          "tag": "h1",
          "text": "Our Story",
          "where": "header"
        },
        {
          "tag": "p",
          "text": "Driven by a passion to help mission-focused organizations succeed.",
          "where": "header"
        },
        {
          "tag": "h2",
          "text": "WHY WE STARTED INSIGHTS",
          "where": "main"
        },
        {
          "tag": "p",
          "text": "We saw firsthand the incredible work being done by mission-driven companies, non-profits, and educational institutions. Yet, too often, these organizations struggled to bridge the gap between their inspiring strategic vision and the day-to-day execution required to achieve it. Goals felt disconnected, progress was hard to track against the core mission, and valuable employee effort wasn't always aligned with the highest priorities.",
          "where": "main"
        },
        {
          "tag": "p",
          "text": "Insights was born from the belief that purpose and performance should go hand-in-hand. We set out to create a platform that not only clarifies strategic objectives but empowers every single employee to see how their work contributes directly to the larger mission. Our goal is to provide the tools and visibility needed for mission-driven organizations to align, engage, and execute with clarity and impact.",
          "where": "main"
        },
        {
          "tag": "h2",
          "text": "MEET THE FOUNDERS",
          "where": "main"
        },
        {
          "tag": "h3",
          "text": "David Hodgson",
          "where": "main"
        },
        {
          "tag": "p",
          "text": "David is a mission-driven executive who helps teams turn complex ideas into meaningful products and services. Known for building strong, values-based cultures, he leads with empathy, clarity, and a deep belief in the power of aligned teams.",
          "where": "main"
        },
        {
          "tag": "p",
          "text": "As former CEO of Project Ronin, David helped bring to market innovative tools that support cancer care—while also shaping a collaborative, purpose-first team culture. His background spans global leaders like Pfizer, Roche and One Medical (now part of Amazon), as well as early-stage startups and growth ventures.",
          "where": "main"
        },
        {
          "tag": "p",
          "text": "Across all his roles, David has guided organizations through growth and change, with a steady focus on people, purpose, and impact. He's also a trusted advisor to purpose-driven companies working to do things differently—and do them well.",
          "where": "main"
        },
        {
          "tag": "h3",
          "text": "Kirsti Tcherkoyan",
          "where": "main"
        },
        {
          "tag": "p",
          "text": "Kirsti is the co-founder and CSO of Insights, a next-gen HR software company helping teams feel more connected to their work—and to each other. With a career that spans tech, media, and consulting, Kirsti knows what it takes to build businesses that grow and scale. She's been part of successful teams at C|Net (acquired by CBS), ThirdAge Media (acquired by Ancestry.com), and All Optic (acquired by Hitachi), and has led her own companies with the same mix of heart and hustle.",
          "where": "main"
        },
        {
          "tag": "p",
          "text": "Before starting Insights, she co-founded Options4Growth, a consulting firm that delivered people-first business strategies to clients across the U.S. and globally. It was eventually acquired by a national accounting firm.",
          "where": "main"
        },
        {
          "tag": "p",
          "text": "Outside of work, Kirsti puts her skills to use mentoring entrepreneurs in Kenya and Uganda, serving on nonprofit boards, and volunteering with CASA to support youth in the foster care system.",
          "where": "main"
        },
        {
          "tag": "p",
          "text": "At her core, Kirsti is all about helping people do meaningful work—and making organizations better places to grow.",
          "where": "main"
        },
        {
          "tag": "h3",
          "text": "Insights",
          "where": "footer"
        },
        {
          "tag": "p",
          "text": "Purpose-powered performance...",
          "where": "footer"
        },
        {
          "tag": "h4",
          "text": "Company",
          "where": "footer"
        },
        {
          "tag": "h4",
          "text": "Connect",
          "where": "footer"
        },
        {
          "tag": "p",
          "text": "© 2025 Insights. All rights reserved.",
          "where": "footer"
        }
