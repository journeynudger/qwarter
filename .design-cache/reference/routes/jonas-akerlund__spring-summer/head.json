        "type": "module"
      },
      "text": "// Exponemos una Promise que Main.js puede awaitar\n      window.__videosDataReady = (async function() {\n        try {\n          const response = await fetch('/api/videos-data');\n          const arrayData = await response.json();\n\n          window.__videosData = arrayData.reduce((obj, urls) => {\n            obj[urls[0]] = urls[1];\n            return obj;\n          }, {});\n\n          return window.__videosData;\n        } catch (error) {\n          console.error('❌ Error cargando videos:', error);\n          window.__videosData = {};\n          return {};\n        }\n      })();"
