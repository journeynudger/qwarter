# Copy to .env.local for local work; set the real values in Vercel → Project → Settings → Environment Variables.
# Everything is optional: with nothing set the site renders fully.

# ---------------------------------------------------------------- site
# The address the site is served from (canonical URLs, sitemap, social cards).
NEXT_PUBLIC_SITE_URL=https://qwarter.com
# Let search engines index this deployment. Leave unset on *.vercel.app; set to 1 on qwarter.com.
ALLOW_INDEXING=
